# Скопируй в .env и заполни при нужде
# Режим без ключа = rule-based демо (работает сразу)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# LLM — provider abstraction, failover. Без ключей бот работает в deterministic режиме.
# Рекомендуемый production: Groq GPT-OSS 120B (быстрый, дешёвый, хороший русский)
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_TIMEOUT=5
LLM_MAX_TOKENS=180

# Fallback (опционально) — если primary недоступен
LLM_FALLBACK_PROVIDER=openai
LLM_FALLBACK_MODEL=gpt-4o-mini
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=https://api.openai.com/v1

# Совместимость: старые ключи всё ещё работают
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=

# WhatsApp Cloud API (Meta) — реальный WhatsApp transport
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
WABA_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
GRAPH_API_VERSION=v21.0
